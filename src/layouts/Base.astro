---
import '../styles/global.css';
import { ui, path, asset, type Lang } from '../i18n/ui';
import { site } from '../data/site';

interface Props {
  lang: Lang;
  page: '' | 'photography' | 'films' | 'about' | '404';
  title: string;
  description: string;
}
const { lang, page, title, description } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'en' ? 'ar' : 'en';
const pageKey = page === '404' ? '' : page;
const origin = Astro.site ? Astro.site.origin : '';
const canonical = origin + path(lang, pageKey);
const navItems = [
  { key: 'photography', label: t.nav.work },
  { key: 'films', label: t.nav.films },
  { key: 'about', label: t.nav.about },
] as const;
const name = lang === 'ar' ? 'أحمد رجب' : site.brand;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: `${site.brand} — Photography & Film`,
  url: origin + path('en'),
  email: site.email,
  telephone: site.phoneHref,
  areaServed: ['Dubai', 'United Arab Emirates', 'Egypt'],
  address: { '@type': 'PostalAddress', addressLocality: 'Dubai', addressCountry: 'AE' },
  founder: { '@type': 'Person', name: site.fullName, jobTitle: 'Photographer & Filmmaker', sameAs: [site.instagram] },
};
---
<!doctype html>
<html lang={lang} dir={t.dir}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {origin && <link rel="canonical" href={canonical} />}
  {page !== '404' && <link rel="alternate" hreflang="en" href={origin + path('en', pageKey)} />}
  {page !== '404' && <link rel="alternate" hreflang="ar" href={origin + path('ar', pageKey)} />}
  {page === '404' && <meta name="robots" content="noindex" />}
  <meta name="theme-color" content="#f4efe6" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.brand} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'ar_AE'} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href={lang === 'ar'
    ? 'https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=IBM+Plex+Sans+Arabic:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,300..700;1,6..72,300..600&display=swap'
    : 'https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..700;1,6..72,300..600&family=Manrope:wght@400;500;600;700&display=swap'} />

  <script is:inline>
    try { if (localStorage.getItem('theme') === 'dark') document.documentElement.dataset.theme = 'dark'; } catch (e) {}
  </script>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <a class="skip" href="#main">{t.skip}</a>
  <header class="masthead">
    <div class="wrap mast-row">
      <nav class="nav" id="nav" aria-label="Main">
        {navItems.map((n) => (
          <a href={path(lang, n.key)} aria-current={page === n.key ? 'page' : undefined}>{n.label}</a>
        ))}
        <a class="nav-book" href={`${path(lang)}#contact`}>{t.nav.contact}</a>
      </nav>
      <a class="wordmark" href={path(lang)} aria-label={name}>{name}</a>
      <div class="tools">
        <a class="tool" href={path(other, pageKey)} hreflang={other} lang={other}>{t.langSwitch}</a>
        <button class="tool icon" type="button" data-theme-toggle aria-label={t.themeDark} data-label-dark={t.themeDark} data-label-light={t.themeLight}>
          <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"/></svg>
          <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
        <button class="tool icon menu-btn" type="button" aria-expanded="false" aria-controls="nav" data-menu>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 8h16M4 16h16"/></svg>
          <span class="visually-hidden">{t.menu}</span>
        </button>
      </div>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <p class="foot-name" aria-hidden="true">{name}</p>
      <div class="foot-row">
        <span class="kicker">© {new Date().getFullYear()} {lang === 'ar' ? 'أحمد رجب' : site.fullName} · {t.footerLine}</span>
        <nav class="kicker" aria-label="Footer">
          <a href={site.instagram} target="_blank" rel="noopener">{t.instagram}</a>
          <a href={`https://wa.me/${site.whatsappNumber}`} target="_blank" rel="noopener">{t.whatsapp}</a>
          <a href={`mailto:${site.email}`}>{t.email}</a>
        </nav>
      </div>
    </div>
  </footer>

  <dialog id="lightbox" aria-label="Photo viewer">
    <div class="lb">
      <div class="lb-bar"><span class="kicker" data-lb-count></span><button class="link-btn" type="button" data-close>{t.close} ✕</button></div>
      <div class="lb-stage" data-lb-stage></div>
      <div class="lb-bar">
        <button class="link-btn" type="button" data-lb-prev>{t.prev}</button>
        <span class="kicker" data-lb-cap></span>
        <button class="link-btn" type="button" data-lb-next>{t.next}</button>
      </div>
    </div>
  </dialog>
  <dialog id="player" aria-label="Video player">
    <div class="lb">
      <div class="lb-bar"><span class="kicker" data-vp-title></span><button class="link-btn" type="button" data-close>{t.close} ✕</button></div>
      <div class="lb-stage"><div class="video-stage" data-vp-stage data-demo-text={t.demoVideo}></div></div>
      <div class="lb-bar"><span></span><a class="link-btn" data-vp-link target="_blank" rel="noopener">{t.openDrive}</a></div>
    </div>
  </dialog>
  <div class="peek" aria-hidden="true"><img alt="" /></div>

  <script>
    import '../scripts/main';
  </script>
</body>
</html>
