---
import '../styles/global.css';
import { ui, path, asset, type Lang } from '../i18n/ui';
import { site } from '../data/site';

interface Props {
  lang: Lang;
  page: '' | 'photography' | 'films' | 'about' | '404';
  title: string;
  description: string;
}
const { lang, page, title, description } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'en' ? 'ar' : 'en';
const pageKey = page === '404' ? '' : page;
const origin = Astro.site ? Astro.site.origin : '';
const canonical = origin + path(lang, pageKey);
const name = lang === 'ar' ? 'أحمد رجب' : 'Ahmed Ragab';
const navItems = [
  { href: path(lang, 'about'), key: 'about', label: t.nav.about },
  { href: path(lang, 'photography'), key: 'photography', label: t.nav.work },
  { href: path(lang, 'films'), key: 'films', label: t.nav.films },
  { href: `${path(lang)}#packages`, key: 'packages', label: t.nav.packages },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: `${site.brand} — Photography & Film`,
  url: origin + path('en'),
  email: site.email,
  telephone: site.phoneHref,
  areaServed: ['Dubai', 'United Arab Emirates', 'Egypt'],
  address: { '@type': 'PostalAddress', addressLocality: 'Dubai', addressCountry: 'AE' },
  founder: { '@type': 'Person', name: site.fullName, jobTitle: 'Photographer & Filmmaker', sameAs: [site.instagram] },
};
---
<!doctype html>
<html lang={lang} dir={t.dir}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {origin && <link rel="canonical" href={canonical} />}
  {page !== '404' && <link rel="alternate" hreflang="en" href={origin + path('en', pageKey)} />}
  {page !== '404' && <link rel="alternate" hreflang="ar" href={origin + path('ar', pageKey)} />}
  {page === '404' && <meta name="robots" content="noindex" />}
  <meta name="theme-color" content="#0d0c0a" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.brand} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'ar_AE'} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href={lang === 'ar'
    ? 'https://fonts.googleapis.com/css2?family=Italiana&family=El+Messiri:wght@400;500;600&family=IBM+Plex+Sans+Arabic:wght@300;400;500&family=JetBrains+Mono:wght@400&display=swap'
    : 'https://fonts.googleapis.com/css2?family=Italiana&family=Manrope:wght@300;400;500;600&family=JetBrains+Mono:wght@400&display=swap'} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body class={page === '' ? 'is-home' : ''}>
  <a class="skip" href="#main">{t.skip}</a>
  <header class="site-header">
    <div class="head-row">
      <nav class="nav" id="nav" aria-label="Main">
        {navItems.map((n) => (
          <a href={n.href} aria-current={page === n.key ? 'page' : undefined}>{n.label}</a>
        ))}
        <a class="nav-only-mobile" href={`${path(lang)}#contact`}>{t.nav.contact}</a>
      </nav>
      <a class="logo" href={path(lang)} aria-label={name}>
        <span class="logo-name">{name}</span>
        <span class="logo-sub">{lang === 'ar' ? 'تصوير · فيديو' : 'Photography · Film'}</span>
      </a>
      <div class="tools">
        <a class="tool" href={path(other, pageKey)} hreflang={other} lang={other}>{t.langSwitch}</a>
        <a class="btn tan small cta-head" href={`${path(lang)}#contact`}>{t.nav.contact}</a>
        <button class="tool menu-btn" type="button" aria-expanded="false" aria-controls="nav" data-menu>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M4 9h16M4 15h16"/></svg>
          <span class="visually-hidden">{t.menu}</span>
        </button>
      </div>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <a class="logo foot-logo" href={path(lang)}>
        <span class="logo-name">{name}</span>
        <span class="logo-sub">{t.footerLine}</span>
      </a>
      <nav class="foot-nav" aria-label="Footer">
        {navItems.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
      <div class="socials">
        <a href={site.instagram} target="_blank" rel="noopener" aria-label={t.instagram}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor"/></svg>
        </a>
        <a href={`https://wa.me/${site.whatsappNumber}`} target="_blank" rel="noopener" aria-label={t.whatsapp}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M4 20l1.3-4A8 8 0 1 1 8 18.7z"/><path d="M9 9.5c.3 2 2.5 4.2 4.5 4.5l1-1.2 1.8.8-.3 1.4c-3 .4-7-3.6-6.6-6.6L10.8 8l.8 1.8z" stroke-width="1"/></svg>
        </a>
        <a href={`mailto:${site.email}`} aria-label={t.email}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="M3.5 6l8.5 7 8.5-7"/></svg>
        </a>
      </div>
      <p class="mono foot-copy">© {new Date().getFullYear()} {name}</p>
    </div>
  </footer>

  <dialog id="lightbox" aria-label="Photo viewer">
    <div class="lb">
      <div class="lb-bar"><span class="mono" data-lb-count></span><button class="link-btn" type="button" data-close>{t.close} ✕</button></div>
      <div class="lb-stage" data-lb-stage></div>
      <div class="lb-bar">
        <button class="link-btn" type="button" data-lb-prev>{t.prev}</button>
        <span class="mono" data-lb-cap></span>
        <button class="link-btn" type="button" data-lb-next>{t.next}</button>
      </div>
    </div>
  </dialog>
  <dialog id="player" aria-label="Video player">
    <div class="lb">
      <div class="lb-bar"><span class="mono" data-vp-title></span><button class="link-btn" type="button" data-close>{t.close} ✕</button></div>
      <div class="lb-stage"><div class="video-stage" data-vp-stage data-demo-text={t.demoVideo}></div></div>
      <div class="lb-bar"><span></span><a class="link-btn" data-vp-link target="_blank" rel="noopener">{t.openDrive}</a></div>
    </div>
  </dialog>

  <script>
    import '../scripts/main';
  </script>
</body>
</html>
