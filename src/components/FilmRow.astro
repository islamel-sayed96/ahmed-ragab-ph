---
// A film as a big editorial row: number, title, type, year, length, poster on hover.
import { ui, type Lang } from '../i18n/ui';
import { poster } from '../data/media';
import { watchUrl, type Film } from '../data/films';

interface Props { lang: Lang; film: Film; n: number }
const { lang, film, n } = Astro.props;
const t = ui[lang];
---
<a class="film-row" href={watchUrl(film.id)} data-video={film.id} data-title={film.title} data-peek={poster(film.id, 900)} data-reveal>
  <span class="fr-n kicker">{String(n).padStart(2, '0')}</span>
  <span class="fr-title">{film.title}</span>
  <span class="fr-meta kicker">{t.filmTypes[film.type]} · {film.year}</span>
  <span class="fr-len kicker">{film.length}</span>
  <span class="fr-play" aria-hidden="true">▶</span>
</a>
