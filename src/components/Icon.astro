---
// Thin line icons for the skills list.
const { name } = Astro.props as { name: string };
---
<svg class="icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'camera' && <><path d="M6 15h8l3-5h14l3 5h8v23H6z" /><circle cx="24" cy="26" r="7.5" /><path d="M36 20h2" /></>}
  {name === 'film' && <><rect x="6" y="11" width="28" height="26" rx="2" /><path d="M34 20l9-5v18l-9-5" /><path d="M6 18h28M6 30h28" /></>}
  {name === 'drone' && <><rect x="19" y="20" width="10" height="8" rx="2" /><path d="M19 22l-8-6M29 22l8-6M19 26l-8 6M29 26l8 6" /><path d="M5 16h12M31 16h12M5 32h12M31 32h12" /></>}
  {name === 'edit' && <><path d="M6 36h36" /><path d="M10 30V12h10M38 30V18" /><path d="M14 30l6-8 5 5 4-6 5 9" /><circle cx="31" cy="12" r="3" /></>}
</svg>
